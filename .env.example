# Application Environment
ENV=development
APP_NAME="Gold Daily Analysis"
TIMEZONE=Asia/Kolkata

# Database URL
# Local SQLite default. Compatible with PostgreSQL / Supabase: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./gold_analysis.db

# Gold Price Provider: "goldapi" or "yahoo"
# "goldapi" requires an API key from https://www.goldapi.io (Free tier: 100 requests/month)
# "yahoo" fetches market data converted to INR/g (requires no key, ideal for 1Y backtesting & daily use)
GOLD_PRICE_PROVIDER=yahoo
GOLDAPI_KEY=

# Cache TTL in minutes (avoids frequent API calls; refresh only on dashboard visit after TTL)
CACHE_TTL_MINUTES=30

# Investment & Tax Settings
FIXED_DAILY_AMOUNT=35.0
GST_RATE=0.03
SELL_SPREAD_PCT=0.03

# India price adjustment (raw feed excludes import duty; 15% since 13 May 2026)
# LOCAL_PREMIUM_PCT: extra dealer premium so the app matches PhonePe/Paytm (0.047 matched Paytm Bengaluru on 7 Oct 2026; re-tune if it drifts)
IMPORT_DUTY_PCT=0.15
LOCAL_PREMIUM_PCT=0.047

# Public deployment: require a login on the API (leave blank for local use)
APP_USERNAME=
APP_PASSWORD=
